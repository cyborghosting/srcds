#!/bin/sh
set -eu

if [ ! -e ~/.local/share/Steam ]; then
  mkdir -p ~/.local/share/Steam/appcache/
  mkdir -p ~/.local/share/Steam/config/
  mkdir -p ~/.local/share/Steam/logs/
  mkdir -p ~/.local/share/Steam/steamapps/common/
fi

if [ ! -e ~/.local/share/Steam/steamcmd ]; then
  mkdir -p ~/.local/share/Steam/steamcmd/linux32/
  mkdir -p ~/.local/share/Steam/steamcmd/linux64/
  cp /opt/steamcmd/steamcmd.sh      ~/.local/share/Steam/steamcmd/steamcmd.sh
  cp /opt/steamcmd/linux32/steamcmd ~/.local/share/Steam/steamcmd/linux32/steamcmd
  ln -s ~/.local/share/Steam/steamcmd/linux32/steamclient.so ~/.local/share/Steam/steamcmd/steamservice.so
  ln -s ~/.local/share/Steam/steamcmd/linux32/steamclient.so ~/.local/share/Steam/steamcmd/linux32/steamservice.so
  ln -s ~/.local/share/Steam/steamcmd/linux64/steamclient.so ~/.local/share/Steam/steamcmd/linux64/steamservice.so
fi

if [ ! -e ~/Steam ]; then
  ln -s ~/.local/share/Steam ~/Steam
fi

if [ ! -e ~/.steam ]; then
  mkdir -p ~/.steam/sdk32/
  mkdir -p ~/.steam/sdk64/
  ln -s ~/.local/share/Steam ~/.steam/root
  ln -s ~/.local/share/Steam ~/.steam/steam
  ln -s ~/.local/share/Steam/steamcmd/linux32/steamclient.so ~/.steam/sdk32/steamclient.so
  ln -s ~/.local/share/Steam/steamcmd/linux64/steamclient.so ~/.steam/sdk64/steamclient.so
fi

exec ~/.local/share/Steam/steamcmd/steamcmd.sh "$@"
